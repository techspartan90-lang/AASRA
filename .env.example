# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI-Assisted Distress Monitoring System (Phase 4)
# ==============================================================================

# --- AI Service Configuration (Server-side Only) ---
# GEMINI_API_KEY: Required for Gemini AI inference (risk factor extraction, explainability).
# Server-only secret accessed via process.env.GEMINI_API_KEY. Never expose in browser.
GEMINI_API_KEY="your-gemini-api-key"

# --- App URL ---
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# --- Supabase Configuration (Frontend & Backend) ---
# NEXT_PUBLIC_SUPABASE_URL: Supabase Project REST / Auth endpoint.
# Safe for browser/client exposure.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous key for client requests (enforced by RLS).
# Safe for browser/client exposure.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Supabase Service Role Key (Backend Only - NEVER expose to browser) ---
# Used exclusively in secure server-side API routes (/api/*) for administrative operations,
# role enforcement, or background sync. Bypasses Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# NOTE: When Supabase credentials are not provided or remain as placeholders,
# the system automatically and gracefully activates the high-fidelity in-memory
# repository layer and deterministic AI fallback engine with synthetic cases.
